{
  "name": "rami-marocain-71",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w client && npm run test -w server",
    "test:browser": "node tests/browser-audit.mjs"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
